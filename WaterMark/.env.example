# Copy to .env.local (git-ignored). Names only; never commit values.
# Public MojoAuth project API key (MojoAuth dashboard: API credentials). Safe in the browser.
VITE_MOJOAUTH_API_KEY=
# Full URL of the auth-verify Edge Function, e.g. <SUPABASE_URL>/functions/v1/auth-verify
VITE_WATERMARK_AUTH_VERIFY_URL=
# Public feed of the Agentboxd alert inbox: <SUPABASE_URL>/functions/v1/alert-inbox/alerts
VITE_WATERMARK_ALERTS_URL=
# Full URL of the agentboxd-auth Edge Function, e.g. <SUPABASE_URL>/functions/v1/agentboxd-auth
# Sign in with Agentboxd needs only this in the browser: client_id and redirect URIs live in
# Supabase secrets, and there is no client secret (public client with PKCE).
VITE_AGENTBOXD_AUTH_URL=
# Full URL of the assistant Edge Function. Pages reads the same name from a repository variable.
# Leave it empty in production until the function is deployed: the chat calls nothing.
# `npm run dev` uses /api/assistant on the Vite server when this is empty.
VITE_WATERMARK_ASSISTANT_URL=
# Dev server only (no VITE_ prefix, so it is not bundled). Never commit a value.
WATERMARK_GEMINI_API_KEY=
# Set to 1 to make the dev assistant route return 503. The Edge Function reads the same name.
WATERMARK_ASSISTANT_DISABLED=
# Full URL of the outlook-summary Edge Function. Empty: the flood outlook shows its figures
# and says AI summaries are not set up. `npm run dev` uses /api/outlook-summary when this is empty.
VITE_WATERMARK_SUMMARY_URL=
# Dev server only (no VITE_ prefix). Never commit a value.
WATERMARK_SUMMARY_API_KEY=
# Optional. Default https://openrouter.ai/api/v1
WATERMARK_SUMMARY_BASE_URL=
# Optional comma-separated model ids, tried in order.
WATERMARK_SUMMARY_MODELS=

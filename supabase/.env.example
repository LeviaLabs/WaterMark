WATERMARK_ALLOWED_ORIGINS=
WATERMARK_NWS_USER_AGENT=
MOJOAUTH_API_KEY=
MOJOAUTH_ISSUER=
# Sign in with Agentboxd (public client: there is no client secret).
# client_id from Agentboxd dashboard > Shakehand > your app. It is public, but set it here, not in code.
AGENTBOXD_CLIENT_ID=
# Exact redirect URIs registered for that app, comma-separated, one per site origin, e.g.
# https://watermark.works/agentboxd-callback.html,http://localhost:5173/agentboxd-callback.html
AGENTBOXD_REDIRECT_URIS=
WATERMARK_GEMINI_API_KEY=
WATERMARK_ASSISTANT_DISABLED=
# Flood-outlook summaries (functions/outlook-summary). Names only; never commit a value.
WATERMARK_SUMMARY_API_KEY=
WATERMARK_SUMMARY_BASE_URL=
WATERMARK_SUMMARY_MODELS=
# Agentboxd alert inbox: webhook signing secret (shown once when the webhook is created).
AGENTBOXD_WEBHOOK_SECRET=
# Senders whose alerts may be accepted: addresses or domains, comma-separated, e.g. usgs.gov
ALERT_SENDER_ALLOWLIST=
